{
  "name": "Investigation",
  "type": "object",
  "properties": {
    "demo_session_id": {
      "type": "string"
    },
    "case_number": {
      "type": "string"
    },
    "tracking_number": {
      "type": "string"
    },
    "scenario_key": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "opened_by": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "string"
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolution": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_summary": {
      "type": "string"
    },
    "physical_verification_requested": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "case_number",
    "tracking_number"
  ]
}