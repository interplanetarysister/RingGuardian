{
  "name": "VideoClip",
  "type": "object",
  "properties": {
    "demo_session_id": {
      "type": "string"
    },
    "clip_key": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "clip_url": {
      "type": "string"
    },
    "evidence_kind": {
      "type": "string",
      "enum": [
        "scene_reconstruction",
        "video_file",
        "ring_clip"
      ],
      "default": "scene_reconstruction"
    },
    "scene": {
      "type": "string"
    },
    "source_label": {
      "type": "string"
    },
    "device_attribution": {
      "type": "string"
    },
    "camera_id": {
      "type": "string"
    },
    "facility": {
      "type": "string"
    },
    "scenario_key": {
      "type": "string"
    },
    "recorded_start": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_end": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "generated_sample": {
      "type": "boolean",
      "default": true
    },
    "uploaded": {
      "type": "boolean",
      "default": false
    },
    "hue": {
      "type": "number"
    },
    "tracking_number": {
      "type": "string"
    },
    "package_dimensions": {
      "type": "string"
    },
    "doorbell_event_key": {
      "type": "string"
    },
    "evidence_provenance": {
      "type": "string"
    },
    "doorway_key": {
      "type": "string"
    },
    "camera_view_role": {
      "type": "string"
    },
    "window_compressed": {
      "type": "boolean"
    },
    "source_window_start": {
      "type": "string"
    },
    "source_window_end": {
      "type": "string"
    },
    "motion_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "playback_start_seconds": {
            "type": "number"
          },
          "playback_end_seconds": {
            "type": "number"
          },
          "source_offset_seconds": {
            "type": "number"
          },
          "source_duration_seconds": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "clip_key",
    "title"
  ]
}